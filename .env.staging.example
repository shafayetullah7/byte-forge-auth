# === Staging environment template ===
# Copy to `.env.staging` on the staging host (or your secret manager) and fill secrets.
# Used with: NODE_ENV=staging docker compose --env-file .env.staging up
#
# Phase 32: enforcement ON in staging only. Production must stay `false` until sign-off.

NODE_ENV=staging
PORT=3005
APP_NAME=byte-forge-api-staging
FRONTEND_URL=https://staging.example.com

# === Database ===
DB_HOST=db
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# === Docker Compose (if deployed via compose) ===
COMPOSE_PROJECT_NAME=byte-forge-staging
APP_EXTERNAL_PORT=3005
DB_EXTERNAL_PORT=5432
DOCKER_BUILD_TARGET=production

SALT_ROUNDS=10

# === Mail (staging) ===
MAIL_PROVIDER=console
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME="Byte Forge Staging"
MAIL_FROM_EMAIL="noreply@staging.example.com"

# === JWT / session — generate unique values for staging ===
JWT_SECRET_RESET_REQUEST=
JWT_SECRET_RESET_ACCESS=
SESSION_MAX_AGE=604800000
COOKIE_DOMAIN=staging.example.com
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_ACCESS_EXP=15m
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_REFRESH_EXP=7d
ADMIN_REGISTRATION_OTP_EMAIL=
JWT_USER_ACCESS_SECRET=
JWT_USER_ACCESS_EXP=15m
JWT_USER_REFRESH_SECRET=
JWT_USER_REFRESH_EXP=7d

# === Cloudinary (staging bucket or separate folder) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Seller subscription (Stripe test mode keys on staging) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
