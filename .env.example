# === Application Settings ===
NODE_ENV=development
PORT=3005
APP_NAME=my-nest-app
FRONTEND_URL=http://localhost:3000

# === Database ===
DB_HOST=db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=1234
DB_NAME=mydb
DB_SSL=false

# === Docker Compose ===
COMPOSE_PROJECT_NAME=myapp
APP_EXTERNAL_PORT=3000
DB_EXTERNAL_PORT=5432
DOCKER_BUILD_TARGET=development

#===hash===
SALT_ROUNDS=10

CLOUDINARY_CLOUD_NAME="defkx8gbe"
CLOUDINARY_API_KEY="359254391667679"
CLOUDINARY_API_SECRET="TLhn1uG_tF7C0sdfsdftE"

# === Mail Configuration ===
MAIL_PROVIDER=console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME="Aponika"
MAIL_FROM_EMAIL="noreply@aponika.com"

# === Session & Cookie ===
SESSION_MAX_AGE=604800000
COOKIE_DOMAIN=localhost

# === Admin JWT ===
JWT_ADMIN_ACCESS_SECRET="generate_a_long_random_string_here_at_least_32_chars"
JWT_ADMIN_ACCESS_EXP="15m"
JWT_ADMIN_REFRESH_SECRET="generate_another_long_random_string_here_at_least_32_chars"
JWT_ADMIN_REFRESH_EXP="7d"

# Gatekeeper inbox for admin registration OTP (not sent to the registrant)
ADMIN_REGISTRATION_OTP_EMAIL="ops@example.com"

# === OIDC (Aponika Auth) ===
OIDC_ISSUER=http://localhost:3010
# Server-side HTTP to IdP (Docker dev). Production: internal service URL e.g. http://aponika-auth-backend:3010
OIDC_INTERNAL_ISSUER=http://host.docker.internal:3010
OIDC_DEFAULT_RESOURCE=http://localhost:3005
OIDC_CLIENT_ID=byte-forge-web
OIDC_REDIRECT_URI=http://localhost:3005/api/v1/user/auth/oidc/callback
# Must match Aponika byte-forge-web post_logout registration exactly
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# === Plant AI (optional) ===
